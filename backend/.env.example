# Copy to backend/.env and adjust. Every setting is a CASCADE_* variable (app/config.py).

# ---- local quick start (offline: Demo LLM, SQLite, local subprocess runtime, no AWS) ----
CASCADE_LLM=demo
CASCADE_AUTH=local
CASCADE_DEMO=true
CASCADE_ARTIFACT_RUNTIME=subprocess
# CASCADE_DATABASE_URL=                      # empty = SQLite under backend/data
# CASCADE_DATABASE_URL=postgresql+psycopg://cascade:cascade@localhost:5433/cascade   # docker-compose
CASCADE_DEMO_LATENCY_MS=2500                 # Demo LLM simulated latency (0 in tests)

# ---- light layer (System 1) ----
CASCADE_EMBED_BACKEND=fastembed              # fastembed | multilingual-e5-small | bedrock-titan | hashing
CASCADE_EMBED_MODEL=BAAI/bge-small-en-v1.5
CASCADE_EMBED_THREADS=2
# Thresholds tuned for bge-small-en-v1.5 and checked against demo/data/eval (make eval):
#   rewordings of the same request score 0.97-0.99; the closest different requests 0.79-0.92.
CASCADE_CACHE_THRESHOLD=0.95                 # semantic cache (a hit also needs equal slots)
CASCADE_PATTERN_THRESHOLD=0.80               # centroid / kNN pattern match
CASCADE_PATTERN_MIN_PROB=0.80
CASCADE_PATTERN_MIN_MARGIN=0.05
CASCADE_GLOBAL_CACHE=true                    # PII-free answers may be shared across users
CASCADE_VOLATILE_TTL_S=0                     # time-sensitive prompts are not cached

# ---- verification / artifacts ----
CASCADE_VERIFY_MIN_SCORE=0.9
CASCADE_ARTIFACT_MIN_CONFIDENCE=0.6

# ---- AWS (production; see DEPLOY.md) ----
# CASCADE_LLM=bedrock
# CASCADE_BEDROCK_REGION=us-east-1
# CASCADE_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
# CASCADE_LIGHT_LLM_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# CASCADE_ARTIFACT_RUNTIME=lambda
# CASCADE_ARTIFACT_ROLE_ARN=arn:aws:iam::<account>:role/cascade-artifact
# CASCADE_ARTIFACT_BUCKET=cascade-artifacts-<account>
