# Copy to .env and adjust. All vars are prefixed CASCADE_.
# ---- local dev defaults (offline, no AWS) ----
CASCADE_STORE_BACKEND=sqlite
CASCADE_HEAVY_BACKEND=mock
CASCADE_EMBED_BACKEND=local
CASCADE_HANDLER_RUNTIME=subprocess
CASCADE_SQLITE_PATH=cascade.db

# ---- AWS production (uncomment / set) ----
# CASCADE_STORE_BACKEND=dynamodb
# CASCADE_HEAVY_BACKEND=bedrock
# CASCADE_EMBED_BACKEND=bedrock
# CASCADE_HANDLER_RUNTIME=lambda
# CASCADE_BEDROCK_REGION=us-east-1
# CASCADE_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# CASCADE_BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# CASCADE_DYNAMO_TABLE_PATTERNS=cascade-patterns
# CASCADE_DYNAMO_TABLE_CACHE=cascade-cache
# CASCADE_DYNAMO_TABLE_LOGS=cascade-logs
# Thresholds are tuned for the local embedder; raise for Bedrock embeddings:
# CASCADE_CACHE_THRESHOLD=0.97
# CASCADE_PATTERN_THRESHOLD=0.88
